{
  "name": "configflow-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "ConfigFlow desktop shell (Electron): window management, backend process lifecycle, native dialogs",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsc && electron . --dev",
    "start": "tsc && electron .",
    "package": "tsc && electron-builder --config electron-builder.yml",
    "build:backend": "..\\backend\\gradlew.bat -p ../backend :bootstrap:bootJar",
    "build:frontend": "npm run build --prefix ../frontend",
    "build:jre": "powershell -ExecutionPolicy Bypass -File ../installer/build-jre.ps1",
    "release": "npm run build:backend && npm run build:frontend && npm run build:jre && npm run package"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2"
  }
}
